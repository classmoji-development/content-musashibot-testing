      "html": "<h2>New Slide</h2>\n<p>Add your content here...</p><div class=\"sl-block\" data-block-type=\"svg\" data-cm-block-id=\"ba6a40ae\" style=\"left: 280px; top: 230px; width: 400px; height: 240px;\"><div class=\"sl-block-content\" style=\"color: rgb(225, 29, 72);\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 10 10\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"></circle></svg></div></div><div class=\"sl-block\" data-block-type=\"html\" data-cm-block-id=\"e1e9b058\" style=\"left: 307px; top: 231px; width: 433px; height: 268px;\"><div class=\"sl-block-content\" style=\"\"><iframe sandbox=\"allow-scripts allow-pointer-lock allow-modals allow-popups\" allow=\"fullscreen\" style=\"width: 100%; height: 100%; border: 0px;\" srcdoc=\"&lt;!DOCTYPE html&gt;&lt;script data-cm-storage-shim&gt;(function(){function m(){var d=new Map();return{get length(){return d.size},key:function(i){var k=Array.from(d.keys());return i&gt;=0&amp;&amp;i&lt;k.length?k[i]:null},getItem:function(k){k=String(k);return d.has(k)?d.get(k):null},setItem:function(k,v){d.set(String(k),String(v))},removeItem:function(k){d.delete(String(k))},clear:function(){d.clear()}}}['localStorage','sessionStorage'].forEach(function(n){try{if(window[n])return}catch(e){}try{Object.defineProperty(window,n,{value:m(),configurable:true,enumerable:true})}catch(e){}})})();&lt;/script&gt;\n&lt;html&gt;&lt;body style=&quot;margin:0;background:#0f172a&quot;&gt;\n&lt;canvas id=&quot;c&quot; width=&quot;640&quot; height=&quot;400&quot;&gt;&lt;/canvas&gt;\n&lt;script&gt;\n// cm-game-marker\nconst c = document.getElementById('c'), g = c.getContext('2d');\nlet x = 50, dx = 4; window.score = 0;\nc.addEventListener('click', () =&gt; { window.score++; });\nfunction frame() {\n  x += dx; if (x &lt; 30 || x &gt; 610) dx = -dx;\n  g.fillStyle = '#0f172a'; g.fillRect(0, 0, 640, 400);\n  g.fillStyle = '#facc15'; g.beginPath(); g.arc(x, 200, 30, 0, 7); g.fill();\n  g.fillStyle = '#fff'; g.font = '28px sans-serif'; g.fillText('Score ' + window.score, 20, 40);\n  requestAnimationFrame(frame);\n}\nframe();\nlocalStorage.setItem('k', 'v');\n&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;\n\"></iframe></div></div>"
