      "id": "53e9cbd9",
      "html": "<h2>Blocks check (agent, temporary)</h2><div class=\"sl-block\" data-block-type=\"svg\" data-cm-block-id=\"a0656a05\" style=\"left: 40px; top: 120px; width: 300px; height: 180px;\"><div class=\"sl-block-content\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 200 120\" preserveAspectRatio=\"xMidYMid meet\"><rect x=\"5\" y=\"5\" width=\"190\" height=\"110\" rx=\"12\" fill=\"#10b981\"></rect><circle cx=\"60\" cy=\"60\" r=\"30\" fill=\"currentColor\"><animate attributeName=\"r\" values=\"30;20;30\" dur=\"2s\" repeatCount=\"indefinite\"></animate></circle><text x=\"100\" y=\"66\" fill=\"#fff\" font-size=\"20\">svg</text></svg></div></div><div class=\"sl-block\" data-block-type=\"html\" data-cm-block-id=\"ca0b5d84\" style=\"left: 500px; top: 300px; width: 440px; height: 260px;\"><div class=\"sl-block-content\"><iframe sandbox=\"allow-scripts allow-pointer-lock allow-modals allow-popups\" allow=\"fullscreen\" style=\"width: 100%; height: 100%; border: 0px;\" srcdoc=\"&lt;!doctype html&gt;&lt;script data-cm-storage-shim&gt;(function(){function m(){var d=new Map();return{get length(){return d.size},key:function(i){var k=Array.from(d.keys());return i&gt;=0&amp;&amp;i&lt;k.length?k[i]:null},getItem:function(k){k=String(k);return d.has(k)?d.get(k):null},setItem:function(k,v){d.set(String(k),String(v))},removeItem:function(k){d.delete(String(k))},clear:function(){d.clear()}}}['localStorage','sessionStorage'].forEach(function(n){try{if(window[n])return}catch(e){}try{Object.defineProperty(window,n,{value:m(),configurable:true,enumerable:true})}catch(e){}})})();&lt;/script&gt;\n&lt;html&gt;&lt;body style=&quot;margin:0;background:#0b1020&quot;&gt;\n&lt;canvas id=&quot;c&quot; width=&quot;400&quot; height=&quot;240&quot;&gt;&lt;/canvas&gt;\n&lt;script&gt;\n  const ctx = document.getElementById('c').getContext('2d');\n  let x = 40, y = 60, dx = 3, dy = 2, frames = 0;\n  localStorage.setItem('best', '1');\n  function tick() {\n    ctx.fillStyle = '#0b1020'; ctx.fillRect(0, 0, 400, 240);\n    ctx.fillStyle = '#ef4444'; ctx.beginPath(); ctx.arc(x, y, 18, 0, Math.PI * 2); ctx.fill();\n    ctx.fillStyle = '#e5e7eb'; ctx.font = '16px sans-serif';\n    ctx.fillText('v2 frames: ' + (++frames) + ' &amp; &quot;quotes&quot; &lt; &gt; best=' + localStorage.getItem('best'), 10, 228);\n    x += dx; y += dy; if (x &lt; 18 || x &gt; 382) dx = -dx; if (y &lt; 18 || y &gt; 202) dy = -dy;\n    requestAnimationFrame(tick);\n  }\n  tick();\n&lt;/script&gt;\n&lt;/body&gt;&lt;/html&gt;\"></iframe></div></div><div class=\"sl-block\" data-block-type=\"iframe\" data-cm-block-id=\"db4ff970\" style=\"left: 40px; top: 400px; width: 420px; height: 240px;\"><div class=\"sl-block-content\"><iframe allowfullscreen=\"\" data-src=\"https://example.com/\" style=\"width: 100%; height: 100%; border: 0px;\"></iframe></div></div>"
